{
  "name": "clue-markets",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "preview": "NODE_USE_ENV_PROXY=1 node server.mjs",
    "build:trading": "esbuild trading-client.js --bundle --minify --format=iife --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --define:global=window --outfile=public/trading.js",
    "build:privy": "esbuild privy-client.jsx --bundle --minify --format=iife --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --define:global=window --loader:.js=jsx --outfile=public/privy.js",
    "test": "node --test tests/*.mjs",
    "build:card": "esbuild card-client.js --bundle --minify --format=iife --target=es2020 --outfile=public/card.js",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "build:trader": "esbuild trader-src.mjs --bundle --platform=node --format=esm --target=node20 --minify --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\" --outfile=../plugin/clue/trader/clue-trader.mjs"
  },
  "dependencies": {
    "@hot-labs/near-connect": "^0.12.0",
    "@napi-rs/canvas": "^1.1.1",
    "@near-js/crypto": "^2.5.1",
    "better-auth": "^1.7.17",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.28.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@polymarket/client": "^0.17.0",
    "@privy-io/react-auth": "^3.51.3",
    "@stripe/stripe-js": "^10.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.16"
  },
  "engines": {
    "node": "24.x"
  },
  "private": true
}
