{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://clue-api-development.up.railway.app/api/oauth/meta/resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "https://clue-api-development.up.railway.app/api/oauth/meta/resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://clue-api-development.up.railway.app/api/oauth/meta/server"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "https://clue-api-development.up.railway.app/api/oauth/meta/server"
    },
    {
      "source": "/api/:path*",
      "destination": "https://clue-api-development.up.railway.app/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/(privy|trading|card|ticket).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
